{
  "name": "@girmmy/google-tasks-mcp-server",
  "version": "1.0.1",
  "mcpName": "io.github.girmmy/google-tasks",
  "description": "MCP server for Google Tasks — list, create, update, complete, delete, and move tasks and task lists via the Google Tasks API",
  "author": "Girmachew Samson (https://github.com/girmmy)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-tasks-mcp-server": "dist/index.js",
    "google-tasks-mcp-auth": "dist/authorize.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/girmmy/google-tasks-mcp-server.git"
  },
  "homepage": "https://github.com/girmmy/google-tasks-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/girmmy/google-tasks-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-tasks",
    "claude",
    "claude-desktop",
    "oauth",
    "codex",
    "cursor",
    "google-api",
    "tasks"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && chmod +x dist/index.js dist/authorize.js",
    "clean": "rm -rf dist",
    "auth": "tsx src/authorize.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "googleapis": "^144.0.0",
    "google-auth-library": "^9.15.0",
    "gaxios": "^6.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
